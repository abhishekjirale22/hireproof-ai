# Keep the DetectifAI key on the backend. Leave blank for demo mode.
DETECTIF_API_KEY=
DATABASE_URL=sqlite:///./hireproof.db
FRONTEND_ORIGIN=http://127.0.0.1:5173
MAX_AUDIO_UPLOAD_MB=20
# Local safety cap, set below the approximate account allotment to reserve credits.
MAX_API_CREDIT_BUDGET=1500
LOW_CREDIT_WARNING_THRESHOLD=200
DEMO_MODE=true
JWT_SECRET=replace-with-a-long-random-secret-before-use
JWT_EXPIRE_MINUTES=480
UPLOAD_DIR=./uploads
AUDIO_RETENTION_DAYS=30
MAX_REQUESTS_PER_MINUTE=10
